pkgname=claudenboxen
pkgver=1.0.0
pkgrel=1
pkgdesc="Run Claude Code inside a gVisor sandbox or a QEMU/KVM virtual machine"
arch=('x86_64' 'aarch64')
url="https://github.com/jesse-osiecki/claudenboxen"
license=('MIT')
depends=('gvisor-bin' 'qemu-img' 'virtiofsd' 'e2fsprogs')
depends_x86_64=('qemu-system-x86')
depends_aarch64=('qemu-system-aarch64')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('d2fa8f0d67446698291acabc2647b71a9a42e3e84daf82a279d886b9e6e90801')

build() {
	cd "$pkgname-$pkgver"
	export CGO_ENABLED=0
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
	go build -ldflags "-X github.com/jesse-osiecki/claudenboxen/cmd.version=$pkgver" -o claudenboxen .
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 claudenboxen "$pkgdir/usr/bin/claudenboxen"
	install -Dm644 packaging/udev/70-claudenboxen.rules "$pkgdir/usr/lib/udev/rules.d/70-claudenboxen.rules"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	./claudenboxen completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/claudenboxen"
	./claudenboxen completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_claudenboxen"
	./claudenboxen completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/claudenboxen.fish"
}
